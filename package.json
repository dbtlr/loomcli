{
  "name": "loomcli",
  "description": "The Loom CLI application framework. Designed to make developing beautiful command-line tools for humans and agents intuitive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbtlr/loomcli.git"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "test": "vp test",
    "verify": "bun run check && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.2",
      "onFail": "error"
    }
  },
  "engines": {
    "pnpm": ">=12.3.2"
  },
  "packageManager": "pnpm@12.3.2"
}
