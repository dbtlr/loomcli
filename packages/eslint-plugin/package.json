{
  "name": "@loomcli/eslint-plugin",
  "version": "0.20.0",
  "description": "The Loom CLI lint rules. Ships ESLint-compatible rules, which oxlint also loads, for what a type cannot express about a declaration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbtlr/loomcli.git"
  },
  "files": [
    "dist",
    "!dist/provenance.json",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/readme-links.mjs pin",
    "postpack": "node ../../scripts/readme-links.mjs unpin"
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@loomcli/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.23.2"
  }
}
