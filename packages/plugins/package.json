{
  "name": "@loomcli/plugins",
  "version": "0.2.0",
  "description": "The Loom CLI plugin pack. Ships every first-party plugin as its own subpath export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbtlr/loomcli.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./help": {
      "types": "./dist/src/help/plugin.d.ts",
      "import": "./dist/src/help/plugin.js"
    },
    "./help/extension": {
      "types": "./dist/src/help/extension.d.ts",
      "import": "./dist/src/help/extension.js"
    },
    "./help/views": {
      "types": "./dist/src/help/views.d.ts",
      "import": "./dist/src/help/views.js"
    },
    "./version": {
      "types": "./dist/src/version/plugin.d.ts",
      "import": "./dist/src/version/plugin.js"
    },
    "./version/views": {
      "types": "./dist/src/version/views.d.ts",
      "import": "./dist/src/version/views.js"
    },
    "./theme": {
      "types": "./dist/src/theme/plugin.d.ts",
      "import": "./dist/src/theme/plugin.js"
    }
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@loomcli/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.23.2"
  }
}
