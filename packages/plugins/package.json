{
  "name": "@loomcli/plugins",
  "version": "0.10.0",
  "description": "The Loom CLI plugin pack. Ships every first-party plugin as its own subpath export.",
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbtlr/loomcli.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "licenses",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    "./completion": {
      "types": "./dist/src/completion/plugin.d.ts",
      "import": "./dist/src/completion/plugin.js"
    },
    "./config": {
      "types": "./dist/src/config/plugin.d.ts",
      "import": "./dist/src/config/plugin.js"
    },
    "./config/extension": {
      "types": "./dist/src/config/extension.d.ts",
      "import": "./dist/src/config/extension.js"
    },
    "./format": {
      "types": "./dist/src/format/plugin.d.ts",
      "import": "./dist/src/format/plugin.js"
    },
    "./format/views": {
      "types": "./dist/src/format/views.d.ts",
      "import": "./dist/src/format/views.js"
    },
    "./help": {
      "types": "./dist/src/help/plugin.d.ts",
      "import": "./dist/src/help/plugin.js"
    },
    "./help/extension": {
      "types": "./dist/src/help/extension.d.ts",
      "import": "./dist/src/help/extension.js"
    },
    "./help/views": {
      "types": "./dist/src/help/views.d.ts",
      "import": "./dist/src/help/views.js"
    },
    "./manifest": {
      "types": "./dist/src/manifest/plugin.d.ts",
      "import": "./dist/src/manifest/plugin.js"
    },
    "./manifest/extension": {
      "types": "./dist/src/manifest/extension.d.ts",
      "import": "./dist/src/manifest/extension.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/plugin.d.ts",
      "import": "./dist/src/mcp/plugin.js"
    },
    "./mcp/extension": {
      "types": "./dist/src/mcp/extension.d.ts",
      "import": "./dist/src/mcp/extension.js"
    },
    "./records": {
      "types": "./dist/src/records.d.ts",
      "import": "./dist/src/records.js"
    },
    "./suggestions": {
      "types": "./dist/src/suggestions/plugin.d.ts",
      "import": "./dist/src/suggestions/plugin.js"
    },
    "./table": {
      "types": "./dist/src/table.d.ts",
      "import": "./dist/src/table.js"
    },
    "./version": {
      "types": "./dist/src/version/plugin.d.ts",
      "import": "./dist/src/version/plugin.js"
    },
    "./version/views": {
      "types": "./dist/src/version/views.d.ts",
      "import": "./dist/src/version/views.js"
    },
    "./theme": {
      "types": "./dist/src/theme/plugin.d.ts",
      "import": "./dist/src/theme/plugin.js"
    }
  },
  "dependencies": {
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@loom/mcp": "workspace:*"
  },
  "peerDependencies": {
    "@loomcli/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.23.2"
  }
}
