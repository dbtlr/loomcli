function __jsonkit_debug {
    if ($env:BASH_COMP_DEBUG_FILE) {
        "$args" | Out-File -Append -FilePath "$env:BASH_COMP_DEBUG_FILE"
    }
}

# A word as the text of a CompletionResult: bare when it holds only ASCII
# letters, digits, and - _ . / : =, unless it starts with one - and holds a .,
# which PowerShell splits at that . when it passes the word bare to a program,
# and otherwise in single quotes, where each ' and each of U+2018 through
# U+201B, which PowerShell also reads as a single quote, is written twice.
filter __jsonkit_quote {
    if ($_ -cmatch '\A[A-Za-z0-9_./:=-]+\z' -and $_ -cnotmatch '\A-[^-].*\.') {
        return $_
    }
    $_ | __jsonkit_single
}

# A word in single quotes, where each ' and each of U+2018 through U+201B is
# written twice.
filter __jsonkit_single {
    $Quoted = "'"
    foreach ($Character in $_.ToCharArray()) {
        $Code = [int]$Character
        if ($Code -eq 39 -or ($Code -ge 8216 -and $Code -le 8219)) {
            $Quoted += $Character
        }
        $Quoted += $Character
    }
    $Quoted + "'"
}

# A word for a program started under Legacy argument passing, which drops an
# empty argument and leaves a " unescaped in the command line the program
# reads: an empty word as "", and each " escaped with a backslash, with the
# backslashes before it doubled.
filter __jsonkit_legacy {
    if ($_ -eq '') {
        return '""'
    }
    $_ -creplace '(\\*)"', '$1$1\"'
}

# The word an element of the command line passes: the value of a constant
# string, which removes its quoting without evaluating it, and otherwise the
# text typed, so a variable or a subexpression reaches the program as typed.
function __jsonkit_word($Element) {
    if ($Element -is [System.Management.Automation.Language.StringConstantExpressionAst]) {
        return $Element.Value
    }
    $Element.Extent.Text
}

# The text an offered word or file name is inserted as. PowerShell replaces
# only the part of a split word after its parameter, which stays on the line
# as typed, so after such a kept parameter the rest of the word is inserted
# single-quoted, which joins it to the parameter as one word.
function __jsonkit_insert($Word, $Kept) {
    if ($Kept -eq '') {
        return $Word | __jsonkit_quote
    }
    $Word.Substring($Kept.Length) | __jsonkit_single
}

# One offered word or file name as a CompletionResult, or as its text alone
# outside FullLanguage, where a CompletionResult cannot be created.
function __jsonkit_result($Text, $Label, $Type, $Tip) {
    if ($ExecutionContext.SessionState.LanguageMode -eq "FullLanguage") {
        [System.Management.Automation.CompletionResult]::new($Text, $Label, $Type, $Tip)
    } else {
        $Text
    }
}

[scriptblock]${__jsonkitCompleterBlock} = {
    param(
            $WordToComplete,
            $CommandAst,
            $CursorPosition
        )

    __jsonkit_debug ""
    __jsonkit_debug "========= starting completion logic =========="
    __jsonkit_debug "WordToComplete: $WordToComplete Command: $CommandAst CursorPosition: $CursorPosition"

    $ShellCompDirectiveError=1
    $ShellCompDirectiveNoSpace=2
    $ShellCompDirectiveNoFileComp=4
    $ShellCompDirectiveFilterFileExt=8
    $ShellCompDirectiveFilterDirs=16
    $ShellCompDirectiveKeepOrder=32

    # Any failure offers nothing. One empty string completes nothing, where
    # returning nothing would let PowerShell complete file names.
    try {
        # The user could have moved the cursor backwards on the command-line.
        # Each element is placed by its offsets: the words before the cursor,
        # then the word under it cut at the cursor, which is empty when the
        # cursor starts a new word.
        $Elements = $CommandAst.CommandElements
        $Program = __jsonkit_word $Elements[0]
        $Words = @()
        $Current = ''
        $Kept = ''
        for ($Index = 1; $Index -lt $Elements.Count; $Index++) {
            $Extent = $Elements[$Index].Extent
            if ($Extent.EndOffset -lt $CursorPosition) {
                $Words += __jsonkit_word $Elements[$Index]
                continue
            }
            if ($Extent.StartOffset -lt $CursorPosition) {
                # PowerShell's parser reads the cut word and runs nothing. A
                # word that does not parse, such as an unclosed quote, offers
                # nothing.
                $Typed = $Extent.Text.Substring(0, $CursorPosition - $Extent.StartOffset)
                # PowerShell's parser splits a bare word that starts with one -
                # at its first ., so a cut word that starts with . and touches
                # the parameter before it, as in -pnotes., is read with it as
                # one word: the parameter as typed, and the cut word read as
                # any other cut word is.
                $Before = $Elements[$Index - 1]
                if ($Index -gt 1 -and $Typed.StartsWith('.', [System.StringComparison]::Ordinal) -and
                    $Before -is [System.Management.Automation.Language.CommandParameterAst] -and
                    $Before.Extent.EndOffset -eq $Extent.StartOffset) {
                    $Kept = $Before.Extent.Text
                    $Words = @($Words | Select-Object -SkipLast 1)
                }
                $Errors = $null
                $Parsed = [System.Management.Automation.Language.Parser]::ParseInput("x $Typed", [ref]$null, [ref]$Errors)
                if ($Errors.Count -gt 0) {
                    __jsonkit_debug "The word under the cursor does not parse: $Typed"
                    return ""
                }
                $Cut = $Parsed.Find({ $args[0] -is [System.Management.Automation.Language.CommandAst] }, $false).CommandElements
                $Current = $Kept + $Typed
                if ($Cut.Count -eq 2) {
                    $Current = $Kept + (__jsonkit_word $Cut[1])
                }
            }
            break
        }

        # PowerShell 7 off Windows expands a ~ and a wildcard in every word an
        # array passes to &, so there the program is started as a process with
        # an argument list, which passes each word as it is.
        $Unix = $PSVersionTable.PSEdition -eq 'Core' -and ($IsLinux -or $IsMacOS)
        $Pattern = [System.Management.Automation.WildcardPattern]::Escape($Program)
        if ($Unix) {
            $Resolved = Get-Command -Name $Pattern -CommandType Application -ErrorAction Ignore | Select-Object -First 1
        } else {
            $Resolved = Get-Command -Name $Pattern -ErrorAction Ignore | Select-Object -First 1
            if ($Resolved -is [System.Management.Automation.AliasInfo]) {
                $Resolved = $Resolved.ResolvedCommand
            }
        }
        if ($null -eq $Resolved) {
            __jsonkit_debug "The program is not found: $Program"
            return ""
        }

        # A program that resolves to a .bat or .cmd file is never called,
        # because cmd.exe reads its arguments again as commands.
        $Application = $Resolved -is [System.Management.Automation.ApplicationInfo]
        if ($Application -and ([System.IO.Path]::GetExtension($Resolved.Path) -in '.bat', '.cmd')) {
            __jsonkit_debug "The program is a batch file: $($Resolved.Path)"
            return ""
        }

        if ($Unix) {
            # Each word reaches the program as its characters, in the process's
            # argument list. The answer is read as UTF-8, and stderr is read to
            # its end and discarded, so a full stderr pipe never stalls the call.
            $Request = @('completion', '__complete', '--') + @($Words) + @($Current)
            __jsonkit_debug "Starting $($Resolved.Path) $Request"
            $Start = [System.Diagnostics.ProcessStartInfo]::new($Resolved.Path)
            foreach ($Word in $Request) {
                $Start.ArgumentList.Add($Word)
            }
            $Start.UseShellExecute = $false
            $Start.RedirectStandardOutput = $true
            $Start.RedirectStandardError = $true
            $Start.StandardOutputEncoding = [System.Text.UTF8Encoding]::new($false)
            $Start.WorkingDirectory = $ExecutionContext.SessionState.Path.CurrentFileSystemLocation.ProviderPath
            $Process = [System.Diagnostics.Process]::Start($Start)
            try {
                $Discarded = $Process.StandardError.ReadToEndAsync()
                $Text = $Process.StandardOutput.ReadToEnd()
                $Process.WaitForExit()
                $null = $Discarded.Result
                $ExitCode = $Process.ExitCode
            } finally {
                $Process.Dispose()
            }
            # One element per line, as & reads a program's output.
            $Out = @($Text -split '\r?\n')
            if ($Out[-1] -eq '') {
                if ($Out.Count -eq 1) {
                    $Out = @()
                } else {
                    $Out = @($Out[0..($Out.Count - 2)])
                }
            }
        } else {
            # PowerShell 7.2 and earlier, and the Legacy style after it, drop an
            # empty argument and leave a " unescaped, so each word is escaped. The
            # Windows style passes Legacy arguments to the files and commands
            # PowerShell lists for it.
            $Legacy = $false
            if ($Application) {
                if ($PSVersionTable.PsVersion -lt [version]'7.2.0' -or
                    ($PSVersionTable.PsVersion -lt [version]'7.3.0' -and -not [ExperimentalFeature]::IsEnabled("PSNativeCommandArgumentPassing"))) {
                    $Legacy = $true
                } elseif ($PSNativeCommandArgumentPassing -eq 'Legacy') {
                    $Legacy = $true
                } elseif ($PSNativeCommandArgumentPassing -eq 'Windows') {
                    $Legacy = ([System.IO.Path]::GetExtension($Resolved.Path) -in '.js', '.vbs', '.wsf') -or
                        ([System.IO.Path]::GetFileNameWithoutExtension($Resolved.Path) -in 'cmd', 'cscript', 'find', 'sqlcmd', 'wscript')
                }
            }
            $Arguments = @($Words) + @($Current)
            if ($Legacy) {
                $Arguments = @($Arguments | __jsonkit_legacy)
            }

            # Each word reaches the program as its characters, in an argument array.
            $Request = @('completion', '__complete', '--') + $Arguments
            __jsonkit_debug "Calling $Program $Request"

            # The answer is UTF-8, which PowerShell reads in the console's encoding.
            $SavedExitCode = $global:LASTEXITCODE
            $Encoding = [Console]::OutputEncoding
            $Recode = $Encoding.CodePage -ne 65001
            try {
                if ($Recode) {
                    [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
                }
                $global:LASTEXITCODE = 0
                $Out = @(& $Resolved @Request 2>$null)
                $ExitCode = $global:LASTEXITCODE
            } finally {
                if ($Recode) {
                    [Console]::OutputEncoding = $Encoding
                }
                $global:LASTEXITCODE = $SavedExitCode
            }
        }
        if ($ExitCode -ne 0) {
            __jsonkit_debug "The program exited with code $ExitCode"
            return ""
        }

        # The last line is a colon and the directive's decimal digits.
        if ($Out.Count -eq 0 -or "$($Out[-1])" -cnotmatch '\A:[0-9]+\z') {
            __jsonkit_debug "The answer holds no directive line"
            return ""
        }
        [int]$Directive = "$($Out[-1])".Substring(1)
        __jsonkit_debug "The completion directive is: $Directive"

        # remove directive (last element) from out
        $Lines = @()
        if ($Out.Count -gt 1) {
            $Lines = @($Out[0..($Out.Count - 2)])
        }
        __jsonkit_debug "The completions are: $Lines"

        if (($Directive -band $ShellCompDirectiveError) -ne 0 ) {
            # Error code.  No completion.
            __jsonkit_debug "Received error from custom completion go code"
            return ""
        }

        $Values = @($Lines | ForEach-Object {
            #Split the output in name and description
            $Name, $Description = "$_".Split("`t",2)
            __jsonkit_debug "Name: $Name Description: $Description"

            # Set the description to a one space string if there is none set.
            # This is needed because the CompletionResult does not accept an empty string as argument
            if (-Not $Description) {
                $Description = " "
            }
            New-Object -TypeName PSCustomObject -Property @{
                Name = "$Name"
                Description = "$Description"
            }
        })

        $Space = " "
        if (($Directive -band $ShellCompDirectiveNoSpace) -ne 0 ) {
            # remove the space here
            __jsonkit_debug "ShellCompDirectiveNoSpace is called"
            $Space = ""
        }

        # Under directive 0 the answer writes no lead for a word that ends at
        # it, such as --path= or -p=, so such a typed word is read as the lead
        # itself: -- and a name that starts with an ASCII letter or digit and
        # holds ASCII letters, digits, _, ., and -, or - and ASCII letters, and
        # then =, matched as text.
        if ($Values.Count -eq 0 -and
            (($Directive -band ($ShellCompDirectiveNoFileComp -bor $ShellCompDirectiveFilterFileExt -bor $ShellCompDirectiveFilterDirs)) -eq 0) -and
            $Current -cmatch '\A(--[A-Za-z0-9][A-Za-z0-9_.-]*|-[A-Za-z]+)=\z') {
            $Values = @(New-Object -TypeName PSCustomObject -Property @{
                Name = $Current
                Description = " "
            })
        }

        # No Command name starts with -, so where files are allowed a first
        # word that starts with - is the lead of a value attached to its
        # option, and every name after it is listed.
        $AnyFile = (($Directive -band $ShellCompDirectiveNoFileComp) -eq 0) -and
            (($Directive -band $ShellCompDirectiveFilterFileExt) -eq 0) -and
            (($Directive -band $ShellCompDirectiveFilterDirs) -eq 0) -and
            $Values.Count -gt 0 -and $Values[0].Name.StartsWith("-", [System.StringComparison]::Ordinal)
        if ((($Directive -band $ShellCompDirectiveFilterFileExt) -ne 0 ) -or
           (($Directive -band $ShellCompDirectiveFilterDirs) -ne 0 ) -or $AnyFile)  {
            # List the folder the word under the cursor names, read literally:
            # its directories, under FilterFileExt its files that end in an
            # offered extension, compared as strings, and after the lead of a
            # value under directive 0 every name.
            $DirectoriesOnly = ($Directive -band $ShellCompDirectiveFilterDirs) -ne 0
            # A first offered word that starts with - is the lead of a value
            # attached to its option, such as --config= or -c: the names after
            # it are listed, each inserted behind it, and a word without it
            # lists nothing.
            $Lead = ""
            $Typed = $Current
            if ($Values.Count -gt 0 -and $Values[0].Name.StartsWith("-", [System.StringComparison]::Ordinal)) {
                $Lead = $Values[0].Name
                $Values = @($Values | Select-Object -Skip 1)
                if (-not $Typed.StartsWith($Lead, [System.StringComparison]::Ordinal)) {
                    return ""
                }
                $Typed = $Typed.Substring($Lead.Length)
            }
            $Split = $Typed.LastIndexOfAny([char[]]@([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar))
            $Folder = $Typed.Substring(0, $Split + 1)
            $Leaf = $Typed.Substring($Split + 1)
            $Base = $ExecutionContext.SessionState.Path.CurrentFileSystemLocation.ProviderPath
            $Extensions = @()
            if (-not $DirectoriesOnly) {
                $Extensions = @($Values | ForEach-Object { "." + $_.Name })
            }
            __jsonkit_debug "Listing $Folder in $Base for extensions $Extensions"
            $Entries = @(Get-ChildItem -LiteralPath ([System.IO.Path]::Combine($Base, $Folder)) -Force:($Leaf.StartsWith('.')) -ErrorAction Ignore | Where-Object {
                $Entry = $_
                $Entry.Name.StartsWith($Leaf, [System.StringComparison]::Ordinal) -and
                    ($AnyFile -or $Entry.PSIsContainer -or @($Extensions | Where-Object { $Entry.Name.EndsWith($_, [System.StringComparison]::Ordinal) }).Count -gt 0)
            })
            if ($Entries.Count -eq 0) {
                return ""
            }
            # A sole file takes a space after it, and a directory none.
            $Entries | ForEach-Object {
                $Text = $Lead + $Folder + $_.Name
                $Type = 'ProviderItem'
                $After = ""
                if ($_.PSIsContainer) {
                    $Text += '/'
                    $Type = 'ProviderContainer'
                } elseif ($Entries.Count -eq 1) {
                    $After = $Space
                }
                __jsonkit_result ((__jsonkit_insert $Text $Kept) + $After) $_.Name $Type $_.Name
            }
            return
        }

        $Values = @($Values | Where-Object {
            # filter the result by string comparison
            $_.Name.StartsWith($Current, [System.StringComparison]::Ordinal)
        })

        # we sort the values in ascending order by name if keep order isn't passed
        if (($Directive -band $ShellCompDirectiveKeepOrder) -eq 0 ) {
            $Values = @($Values | Sort-Object -Property Name)
        }

        if ($Values.Count -eq 0) {
            if (($Directive -band $ShellCompDirectiveNoFileComp) -ne 0 ) {
                __jsonkit_debug "ShellCompDirectiveNoFileComp is called"
                # Just print an empty string here so the
                # shell does not start to complete paths.
                return ""
            }
            # Returning nothing leaves PowerShell its own file completion.
            return
        }

        # A sole word is inserted with a space after it, as Cobra's Complete
        # mode inserts it, unless the directive asks for no space.
        $After = ""
        if ($Values.Count -eq 1) {
            $After = $Space
        }
        $Values | ForEach-Object {
            __jsonkit_result ((__jsonkit_insert $_.Name $Kept) + $After) $_.Name 'ParameterValue' $_.Description
        }
    } catch {
        __jsonkit_debug "Completion failed: $_"
        return ""
    }
}

Register-ArgumentCompleter -Native -CommandName 'jsonkit' -ScriptBlock ${__jsonkitCompleterBlock}
