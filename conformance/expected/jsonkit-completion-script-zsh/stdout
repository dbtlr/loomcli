__loom_jsonkit_debug()
{
    local file="$BASH_COMP_DEBUG_FILE"
    if [[ -n ${file} ]]; then
        echo "$*" >> "${file}"
    fi
}

# Offers the file names in the folder the word under the cursor names: all of
# them (any), only the folders (dirs), or the folders and the names that end in
# one of the extensions in the caller's lines array, compared as strings
# (extensions). The folder part of the word, through its last /, moves to
# IPREFIX and is inserted as typed. Its quoting is removed with (Q), which
# expands nothing, and only a leading ~/ is read as the home folder. The folder
# is listed by a glob in which only the trailing * is live, so no substitution,
# parameter, glob qualifier, or tilde in the typed text is evaluated. A dot-name
# is listed only when the typed name starts with a dot. Each name is quoted by
# compquote, which escapes a leading ~ or = too, and inserted as quoted with
# compadd -Q, so the inserted word is the name; the listing shows the name. The
# operator's styles for the files or directories tag, such as matcher-list and
# format, reach compadd through _description, which only reads styles and runs
# before emulate because it needs the completion system's options. compadd -f
# tests each name in that folder, so a folder is shown and inserted with a /.
__loom_jsonkit_offer_files()
{
    local -a expl
    if [[ $1 == dirs ]]; then
        _description directories expl directory
    else
        _description files expl file
    fi
    emulate -L zsh
    local kind=$1 typed=$PREFIX lead=$IPREFIX folder name filter keep
    local -a found names shown where

    compset -P '*/'
    folder=${(Q)typed[1,$#typed-$#PREFIX]}
    # A ~/ after the lead of an attached value reaches the program as typed.
    if [[ -z $lead && ${typed[1,2]} == '~/' && -n $HOME ]]; then
        folder=${HOME%/}/${folder[3,-1]}
    fi
    if [[ ${(Q)PREFIX} == .* ]]; then
        found=("$folder"*(ND))
    else
        found=("$folder"*(N))
    fi
    for name in "${found[@]}"; do
        name=${name:t}
        keep=1
        if [[ $kind != any && ! -d $folder$name ]]; then
            keep=0
            if [[ $kind == extensions ]]; then
                for filter in "${lines[@]}"; do
                    [[ $name == *."$filter" ]] && keep=1
                done
            fi
        fi
        (( keep )) && names+=("$name")
    done
    [[ -n $folder ]] && where=(-W "$folder")
    __loom_jsonkit_debug "Offering ${#names[@]} file names in '${folder}'"
    shown=("${(@V)names}")
    compquote names
    compadd -Q -f "${expl[@]}" "${where[@]}" -d shown -- "${names[@]}"
}

# Whether a word is the lead of a value attached to its option and nothing
# after it: -- and a name that starts with an ASCII letter or digit and holds
# ASCII letters, digits, _, ., and -, or - and ASCII letters, and then =. The
# word is matched as text, so nothing in it runs.
__loom_jsonkit_bare_lead()
{
    emulate -L zsh -o extendedglob
    [[ $1 == (--[A-Za-z0-9][-A-Za-z0-9_.]#|-[A-Za-z]##)= ]]
}

_loom_jsonkit()
{
    local shellCompDirectiveError=1
    local shellCompDirectiveNoSpace=2
    local shellCompDirectiveNoFileComp=4
    local shellCompDirectiveFilterFileExt=8
    local shellCompDirectiveFilterDirs=16
    local shellCompDirectiveKeepOrder=32

    local out directive comp lastLine
    local -a completions request describe

    __loom_jsonkit_debug "\n========= starting completion logic =========="
    __loom_jsonkit_debug "CURRENT: ${CURRENT}, words[*]: ${words[*]}"

    # The cursor is inside an unclosed quote, so the word under it cannot be
    # read without evaluating it: offer nothing and do not call the program.
    if [[ -n ${compstate[quote]} ]]; then
        __loom_jsonkit_debug "The word under the cursor holds an unclosed quote"
        return 1
    fi

    # The user could have moved the cursor backwards on the command-line.
    # We need to trigger completion from the $CURRENT location, so the request
    # holds the words before the $CURRENT location and then $PREFIX, the word
    # under the cursor cut at the cursor. The (Q) flag removes one level of
    # quoting and expands nothing, and each word reaches the program as its
    # characters, in an argument array.
    request=("${(Q)words[1]}" completion __complete -- "${(@Q)words[2,CURRENT-1]}" "${(Q)PREFIX}")
    __loom_jsonkit_debug "About to call: ${request[*]}"

    out=$("${request[@]}" 2>/dev/null)
    if [[ $? -ne 0 ]]; then
        __loom_jsonkit_debug "The program exited nonzero"
        return 1
    fi
    __loom_jsonkit_debug "completion output: ${out}"

    # The last line is a colon and the directive's decimal digits.
    lastLine=${out##*$'\n'}
    __loom_jsonkit_debug "last line: ${lastLine}"
    if [[ ${lastLine[1]} != : || -z ${lastLine[2,-1]} || ${lastLine[2,-1]} == *[^0-9]* ]]; then
        __loom_jsonkit_debug "The answer holds no directive line"
        return 1
    fi
    directive=$(( 10#${lastLine[2,-1]} ))
    out=${out%"$lastLine"}

    __loom_jsonkit_debug "directive: ${directive}"
    __loom_jsonkit_debug "completions: ${out}"

    if [ $((directive & shellCompDirectiveError)) -ne 0 ]; then
        __loom_jsonkit_debug "Completion received error. Ignoring completions."
        return 1
    fi

    local tab=$'\t'
    local -a lines
    while IFS= read -r comp; do
        if [ -n "$comp" ]; then
            lines+=("$comp")
            # If requested, completions are returned with a description.
            # The description is preceded by a TAB character.
            # For zsh's _describe, we need to use a : instead of a TAB.
            # We first need to escape any \ and then any : in the word and the
            # description, because _describe reads a backslash as an escape.
            comp=${comp//\\/\\\\}
            comp=${comp//:/\\:}
            comp=${comp//$tab/:}

            __loom_jsonkit_debug "Adding completion: ${comp}"
            completions+=("$comp")
        fi
    done <<< "$out"

    # Under directive 0 the answer writes no lead for a word that ends at it,
    # such as --path= or -p=, so such a typed word is read as the lead itself.
    if [ $((directive & (shellCompDirectiveNoFileComp | shellCompDirectiveFilterFileExt | shellCompDirectiveFilterDirs))) -eq 0 ] &&
        (( ${#lines} == 0 )) && __loom_jsonkit_bare_lead "$PREFIX"; then
        lines=("$PREFIX")
    fi

    if [ $((directive & shellCompDirectiveFilterFileExt)) -ne 0 ] || [ $((directive & shellCompDirectiveFilterDirs)) -ne 0 ] ||
        { [ $((directive & shellCompDirectiveNoFileComp)) -eq 0 ] && [[ ${lines[1]-} == -* ]]; }; then
        # The script lists the file names itself. A first word that starts
        # with - is the lead of a value attached to its option, such as
        # --config= or -c: it moves from PREFIX to IPREFIX as a literal, so the
        # names after it are listed, and a word without it lists nothing. No
        # Command name starts with -, so under directive 0 such a word is a
        # lead too, and every name is listed.
        if [[ ${lines[1]-} == -* ]]; then
            compset -P "${(b)lines[1]}" || return 1
            shift lines
        fi
        if [ $((directive & shellCompDirectiveFilterFileExt)) -ne 0 ]; then
            __loom_jsonkit_debug "File extensions: ${lines[*]}"
            __loom_jsonkit_offer_files extensions
        elif [ $((directive & shellCompDirectiveFilterDirs)) -ne 0 ]; then
            __loom_jsonkit_offer_files dirs
        else
            __loom_jsonkit_offer_files any
        fi
        return
    else
        if [ $((directive & shellCompDirectiveKeepOrder)) -ne 0 ]; then
            __loom_jsonkit_debug "Activating keep order."
            describe+=(-V)
        fi
        describe+=(completions completions)
        if [ $((directive & shellCompDirectiveNoSpace)) -ne 0 ]; then
            __loom_jsonkit_debug "Activating nospace."
            describe+=(-S '')
        fi

        __loom_jsonkit_debug "Calling _describe"
        if _describe "${describe[@]}"; then
            __loom_jsonkit_debug "_describe found some completions"

            # Return the success of having called _describe
            return 0
        else
            __loom_jsonkit_debug "_describe did not find completions."
            __loom_jsonkit_debug "Checking if we should do file completion."
            if [ $((directive & shellCompDirectiveNoFileComp)) -ne 0 ]; then
                __loom_jsonkit_debug "deactivating file completion"

                # We must return an error code here to let zsh know that there were no
                # completions found by _describe; this is what will trigger other
                # matching algorithms to attempt to find completions.
                # For example zsh can match letters in the middle of words.
                return 1
            else
                # Perform file completion
                __loom_jsonkit_debug "Activating file completion"

                # We must return the result of this command, so it must be the
                # last command, or else we must store its result to return it.
                __loom_jsonkit_offer_files any
            fi
        fi
    fi
}

# Run the completion function when compinit autoloads this file as _jsonkit,
# and not when it is sourced.
if [ "$funcstack[1]" = "_jsonkit" ]; then
    _loom_jsonkit
fi
