__loom_jsonkit_debug()
{
    local file="$BASH_COMP_DEBUG_FILE"
    if [[ -n ${file} ]]; then
        echo "$*" >> "${file}"
    fi
}

_loom_jsonkit()
{
    local shellCompDirectiveError=1
    local shellCompDirectiveNoSpace=2
    local shellCompDirectiveNoFileComp=4
    local shellCompDirectiveFilterFileExt=8
    local shellCompDirectiveFilterDirs=16
    local shellCompDirectiveKeepOrder=32

    local out directive comp lastLine filter subdir result
    local -a completions request describe globs

    __loom_jsonkit_debug "\n========= starting completion logic =========="
    __loom_jsonkit_debug "CURRENT: ${CURRENT}, words[*]: ${words[*]}"

    # The cursor is inside an unclosed quote, so the word under it cannot be
    # read without evaluating it: offer nothing and do not call the program.
    if [[ -n ${compstate[quote]} ]]; then
        __loom_jsonkit_debug "The word under the cursor holds an unclosed quote"
        return 1
    fi

    # The user could have moved the cursor backwards on the command-line.
    # We need to trigger completion from the $CURRENT location, so the request
    # holds the words before the $CURRENT location and then $PREFIX, the word
    # under the cursor cut at the cursor. The (Q) flag removes one level of
    # quoting and expands nothing, and each word reaches the program as its
    # characters, in an argument array.
    request=("${(Q)words[1]}" completion __complete -- "${(@Q)words[2,CURRENT-1]}" "${(Q)PREFIX}")
    __loom_jsonkit_debug "About to call: ${request[*]}"

    out=$("${request[@]}" 2>/dev/null)
    if [[ $? -ne 0 ]]; then
        __loom_jsonkit_debug "The program exited nonzero"
        return 1
    fi
    __loom_jsonkit_debug "completion output: ${out}"

    # The last line is a colon and the directive's decimal digits.
    lastLine=${out##*$'\n'}
    __loom_jsonkit_debug "last line: ${lastLine}"
    if [[ ${lastLine[1]} != : || -z ${lastLine[2,-1]} || ${lastLine[2,-1]} == *[^0-9]* ]]; then
        __loom_jsonkit_debug "The answer holds no directive line"
        return 1
    fi
    directive=$(( 10#${lastLine[2,-1]} ))
    out=${out%"$lastLine"}

    __loom_jsonkit_debug "directive: ${directive}"
    __loom_jsonkit_debug "completions: ${out}"

    if [ $((directive & shellCompDirectiveError)) -ne 0 ]; then
        __loom_jsonkit_debug "Completion received error. Ignoring completions."
        return 1
    fi

    local tab=$'\t'
    local -a lines
    while IFS= read -r comp; do
        if [ -n "$comp" ]; then
            lines+=("$comp")
            # If requested, completions are returned with a description.
            # The description is preceded by a TAB character.
            # For zsh's _describe, we need to use a : instead of a TAB.
            # We first need to escape any \ and then any : in the word and the
            # description, because _describe reads a backslash as an escape.
            comp=${comp//\\/\\\\}
            comp=${comp//:/\\:}
            comp=${comp//$tab/:}

            __loom_jsonkit_debug "Adding completion: ${comp}"
            completions+=("$comp")
        fi
    done <<< "$out"

    if [ $((directive & shellCompDirectiveFilterFileExt)) -ne 0 ]; then
        # File extension filtering. Each extension is quoted as a pattern,
        # so no glob qualifier in it runs.
        for filter in "${lines[@]}"; do
            globs+=(-g "*.${(b)filter}")
        done
        __loom_jsonkit_debug "File filtering patterns: ${globs[*]}"
        _files "${globs[@]}"
    elif [ $((directive & shellCompDirectiveFilterDirs)) -ne 0 ]; then
        # File completion for directories only
        subdir="${lines[1]}"
        if [ -n "$subdir" ]; then
            __loom_jsonkit_debug "Listing directories in $subdir"
            pushd -q -- "${subdir}" >/dev/null 2>&1 || return 1
        else
            __loom_jsonkit_debug "Listing directories in ."
        fi

        _files -/
        result=$?
        if [ -n "$subdir" ]; then
            popd -q >/dev/null 2>&1
        fi
        return $result
    else
        if [ $((directive & shellCompDirectiveKeepOrder)) -ne 0 ]; then
            __loom_jsonkit_debug "Activating keep order."
            describe+=(-V)
        fi
        describe+=(completions completions)
        if [ $((directive & shellCompDirectiveNoSpace)) -ne 0 ]; then
            __loom_jsonkit_debug "Activating nospace."
            describe+=(-S '')
        fi

        __loom_jsonkit_debug "Calling _describe"
        if _describe "${describe[@]}"; then
            __loom_jsonkit_debug "_describe found some completions"

            # Return the success of having called _describe
            return 0
        else
            __loom_jsonkit_debug "_describe did not find completions."
            __loom_jsonkit_debug "Checking if we should do file completion."
            if [ $((directive & shellCompDirectiveNoFileComp)) -ne 0 ]; then
                __loom_jsonkit_debug "deactivating file completion"

                # We must return an error code here to let zsh know that there were no
                # completions found by _describe; this is what will trigger other
                # matching algorithms to attempt to find completions.
                # For example zsh can match letters in the middle of words.
                return 1
            else
                # Perform file completion
                __loom_jsonkit_debug "Activating file completion"

                # We must return the result of this command, so it must be the
                # last command, or else we must store its result to return it.
                _files
            fi
        fi
    fi
}

# Run the completion function when compinit autoloads this file as _jsonkit,
# and not when it is sourced.
if [ "$funcstack[1]" = "_jsonkit" ]; then
    _loom_jsonkit
fi
