.TH "JSONKIT\-COMPLETION" "1" "" "jsonkit 0.0.0" ""
.SH "NAME"
jsonkit\-completion \- Print or install a shell completion script.
.SH "SYNOPSIS"
.nf
\fBjsonkit completion\fR <command> [options]
.fi
.SH "COMMANDS"
.TP
\fBbash\fR
Print the Bash completion script.
.TP
\fBzsh\fR
Print the Zsh completion script.
.TP
\fBfish\fR
Print the Fish completion script.
.TP
\fBpowershell\fR
Print the PowerShell completion script.
.TP
\fBinstall\fR
Install completion for your shell.
.TP
\fBupdate\fR
Bring installed completion up to date with this version.
.TP
\fBuninstall\fR
Remove completion from your shell.
.SH "SEE ALSO"
\fBjsonkit\fR(1), \fBjsonkit\-completion\-bash\fR(1), \fBjsonkit\-completion\-zsh\fR(1), \fBjsonkit\-completion\-fish\fR(1), \fBjsonkit\-completion\-powershell\fR(1), \fBjsonkit\-completion\-install\fR(1), \fBjsonkit\-completion\-update\fR(1), \fBjsonkit\-completion\-uninstall\fR(1)
